rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidNewRegistration(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'gender', 'event', 'transactionId', 'createdAt', 'registeredAt', 'status'])
        && (data.keys().size() == 9 || (data.keys().size() == 10 && 'age' in data))
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15
        && data.gender is string && data.gender.size() <= 20
        && (('age' in data) ? (data.age is string || data.age is number) : true)
        && data.event is string && data.event.size() <= 200
        && data.transactionId is string && data.transactionId.size() > 0 && data.transactionId.size() <= 100
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.registeredAt == request.time;
    }

    // --- Enquiries ---
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) 
        && isValidEnquiry(incoming());
      
      function isValidEnquiry(data) {
        return data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
          && data.keys().size() <= 6
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() <= 100
          && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
          && data.createdAt == request.time
          && (data.get('club', '') is string && data.get('club', '').size() <= 100);
      }
    }

    // --- Registrations ---
    match /registrations/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidRegistration(incoming());

      function isValidRegistration(data) {
        return data.keys().hasAll(['name', 'email', 'phone', 'gender', 'event', 'transactionId', 'createdAt', 'status'])
          && data.keys().size() == 8
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() <= 100
          && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15
          && data.gender is string && data.gender.size() <= 20
          && data.event is string && data.event.size() <= 200
          && data.transactionId is string && data.transactionId.size() > 0 && data.transactionId.size() <= 100
          && data.status == 'pending'
          && data.createdAt == request.time;
      }
    }

    // --- New Registrations 2025 ---
    match /events_2025_new/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true; 
    }

    // --- Starbucks Grande Run Registrations ---
    match /event_starbucks/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- Murphies Sunday Reset Registrations ---
    match /event_murphies_sunday_reset/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- New Registrations 2026 ---
    match /events_2026_new/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- Third Wave Sunday Run Registrations ---
    match /event_third_wave/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- Kuti Coffee Run Registrations ---
    match /event_kuti/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- Sora Sunrise Run Registrations ---
    match /sora_sunrise_run/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- Kiosk Kaffee Rhythm Run Registrations ---
    match /kiosk_kaffee_rythm_run/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- Sante Fifa Run Registrations ---
    match /sante_run/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }

    // --- High Spirits Run Registrations ---
    match /event_high_spirits/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidNewRegistration(incoming());
      
      allow list: if true;
    }
  }
}
